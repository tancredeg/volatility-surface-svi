# Data
# Raw vendor quotes (Yahoo Finance) are NOT redistributed: their terms forbid it.
# Keep them locally in data/raw/; only their metadata and SHA-256 are versioned
# (data/snapshots/). The bundled synthetic sample (data/sample/) is versioned.
data/raw/
data/*.csv
# Metadata skeletons written by scripts/fetch_data.py, versioned only once completed and renamed
data/snapshots/*.draft.json

# Scratch outputs (run_results.py --fast)
out/

